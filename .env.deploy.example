COMPOSE_PROJECT_NAME=cpinsight

POSTGRES_DB=cpinsight
POSTGRES_USER=cpinsight
POSTGRES_PASSWORD=replace-with-strong-db-password

DATABASE_URL=postgres://cpinsight:replace-with-strong-db-password@postgres:5432/cpinsight
REDIS_URL=redis://redis:6379

NODE_ENV=production
PORT=4000
API_BASE_URL=https://api.cpinsight.app
FRONTEND_ORIGIN=https://cpinsight.app,https://www.cpinsight.app

JWT_ACCESS_SECRET=replace-with-at-least-64-random-characters-access-secret
JWT_REFRESH_SECRET=replace-with-at-least-64-random-characters-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
BCRYPT_ROUNDS=12

CODEFORCES_API_BASE=https://codeforces.com/api
LEETCODE_GRAPHQL_ENDPOINT=https://leetcode.com/graphql
CODECHEF_BASE_URL=https://www.codechef.com
