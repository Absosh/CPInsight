{
  "name": "cpinsight-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "CPInsight frontend and AI design system workspace.",
  "scripts": {
    "verify:ai-design-system": "node scripts/verify-ai-design-system.js",
    "verify:ai-coach-workspace": "node scripts/verify-ai-coach-workspace.js",
    "verify:live-monitoring": "node scripts/verify-live-monitoring.js",
    "verify:review-worker": "node scripts/verify-review-worker.js",
    "dev:ai-coach": "vite",
    "build:landing-runtime": "esbuild script/landing_skill_graph.js --bundle --format=esm --platform=browser --target=es2020 --outfile=script/landing_skill_graph.bundle.js && esbuild script/landing_page.js --bundle --format=esm --platform=browser --target=es2020 --external:./landing_skill_graph.bundle.js --outfile=script/landing_page.bundle.js",
    "build:frontend": "npm run build:landing-runtime && vite build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "echarts": "^6.1.0",
    "framer-motion": "^13.0.0",
    "motion": "^13.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vis-network": "^10.1.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^8.6.14",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "esbuild": "^0.25.12",
    "storybook": "^8.6.14",
    "vite": "^6.0.0"
  }
}
